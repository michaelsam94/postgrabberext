{
  "manifest_version": 3,
  "name": "PostGrabber",
  "version": "1.2.3",
  "description": "Right-click Facebook posts to copy, save to a JSON-backed queue, and load posts into the composer.",
  "permissions": ["contextMenus", "clipboardWrite", "storage", "tabs"],
  "host_permissions": [
    "*://www.facebook.com/*",
    "*://web.facebook.com/*",
    "*://m.facebook.com/*",
    "*://facebook.com/*",
    "*://*.fbcdn.net/*",
    "*://*.fna.fbcdn.net/*",
    "*://static.xx.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PostGrabber: open queue"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.facebook.com/*",
        "*://web.facebook.com/*",
        "*://m.facebook.com/*",
        "*://facebook.com/*"
      ],
      "js": ["logger.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
